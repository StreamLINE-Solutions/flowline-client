[Unit]
Description=FlowLINE
Requires=network.target
After=systemd-user-sessions.service

[Service]
Type=simple
ExecStart=/usr/bin/flowline --service
# kill --tray and --server both
# C-07 (audit 21/09) : -x (nom exact du processus) au lieu de -f (ligne de
# commande complète) — évite de tuer un processus tiers dont la cmdline
# contiendrait « flowline -- ».
ExecStop=pkill -x flowline
# note : -x ne permet pas de cibler un seul mode (--tray ou --server).
PIDFile=/run/flowline.pid
KillMode=mixed
TimeoutStopSec=30
User=root
LimitNOFILE=100000
Environment="PULSE_LATENCY_MSEC=60" "PIPEWIRE_LATENCY=1024/48000"

[Install]
WantedBy=multi-user.target